{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    // GNOME Shell 51 runs gjs 1.90 on SpiderMonkey 140: all of ES2025 that TypeScript types
    // (iterator helpers, Set methods, RegExp.escape, Promise.withResolvers) is there. Not there:
    // Atomics, structuredClone and `using` (Symbol.dispose); do not use them.
    "target": "ES2025",
    "lib": ["ES2025"],
    "outDir": "./build/js",
    "rootDir": "./src",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "removeComments": false,
    "sourceMap": false,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
