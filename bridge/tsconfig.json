{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./build/js",
    "rootDir": "./src",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "removeComments": false,
    "sourceMap": false,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
