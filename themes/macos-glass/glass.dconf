# Liquid Glass (розширення liquid-glass@thinkingcoding1231.gmail.com, github.com/ryohsuke1231/liquid-glass).
# Скло: верхня панель (пігулка), док Dash to Dock, меню, швидкі налаштування, сповіщення, OSD.
# Усе зайве вимкнено: лаунчер (його замінює Spotlight теми), годинник і віджети на робочому столі.
[org/gnome/shell/extensions/liquid-glass]
top-bar-style='pill'
enable-dock-glass=true
enable-menu-glass=true
enable-quick-settings-glass=true
enable-notification-glass=true
enable-osd-glass=true
enable-application-glass=false
enable-launcher=false
enable-glass-clock=false
enable-desktop-widgets=false
enable-menu-animation=false
# Blur my Shell далі працює для решти (огляд, застосунки); під склом розширення само вимикає його розмиття
blur-my-shell-override=true
