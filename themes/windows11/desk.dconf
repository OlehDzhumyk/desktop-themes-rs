# desk-bridge skin for the Windows 11 theme: Win+V clipboard flyout next to the text cursor
# (the Windows 11 behavior module moves the notification list to Super+N).
[io/github/OlehDzhumyk/Desk]
skin='windows11'

[io/github/OlehDzhumyk/Desk/clipboard]
toggle-shortcut=['<Super>v']

# Volume mixer flyout: Win+Ctrl+V, as Windows 11 opens its sound output panel.
[io/github/OlehDzhumyk/Desk/mixer]
mixer-shortcut=['<Control><Super>v']

# Emoji and symbol picker: Win+. and Win+;, opening the Emoji tab of the unified flyout.
[io/github/OlehDzhumyk/Desk/emoji]
emoji-shortcut=['<Super>period', '<Super>semicolon']

# Colour picker: Win+Shift+C, as PowerToys Color Picker.
[io/github/OlehDzhumyk/Desk/color-picker]
color-picker-shortcut=['<Shift><Super>c']

# Text extractor (OCR): Shift+Super+T, as PowerToys Text Extractor.
[io/github/OlehDzhumyk/Desk/ocr]
ocr-shortcut=['<Shift><Super>t']
