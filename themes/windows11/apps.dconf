# Модуль apps (Windows 11): Ptyxis. Brave слідує GTK-темі сам (see docs/themes.md), хуків немає.
# @DEFAULT_PTYXIS_PROFILE@ is replaced by the default Ptyxis profile UUID (dconf default-profile-uuid).
[org/gnome/Ptyxis]
use-system-font=false
font-name='Cascadia Mono 12'
cursor-shape='ibeam'

[org/gnome/Ptyxis/Profiles/@DEFAULT_PTYXIS_PROFILE@]
palette='campbell'
