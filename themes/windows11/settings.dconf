[org/gnome/desktop/interface]
gtk-theme='Fluent-round'
icon-theme='Fluent'
cursor-theme='Fluent-cursors'

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/desktop/background]
picture-uri='file://${HOME}/.local/share/backgrounds/windows11/bloom-light.png'
picture-uri-dark='file://${HOME}/.local/share/backgrounds/windows11/bloom-dark.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file://${HOME}/.local/share/backgrounds/windows11/bloom-dark.png'

[org/gnome/mutter]
center-new-windows=true

[org/gnome/shell/extensions/user-theme]
name='Fluent-round-Dark'
