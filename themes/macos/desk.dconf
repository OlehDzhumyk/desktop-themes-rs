# desk-bridge skin for the macOS theme: Spotlight-like clipboard panel on Shift+Super+V
# (Super+V stays the notification list, as in the macOS behavior module).
[io/github/OlehDzhumyk/Desk]
skin='macos'

[io/github/OlehDzhumyk/Desk/clipboard]
toggle-shortcut=['<Shift><Super>v']

# Emoji and symbol picker: Ctrl+Super+Space (macOS Character Viewer convention).
[io/github/OlehDzhumyk/Desk/emoji]
emoji-shortcut=['<Control><Super>space']

# Colour picker: Ctrl+Shift+Super+C (Digital Color Meter copies with Cmd+Shift+C).
[io/github/OlehDzhumyk/Desk/color-picker]
color-picker-shortcut=['<Control><Shift><Super>c']

# Text extractor (OCR): Ctrl+Shift+Super+T (macOS has no global OCR key; Cmd+Shift+T is taken by apps).
[io/github/OlehDzhumyk/Desk/ocr]
ocr-shortcut=['<Control><Shift><Super>t']

# Screenshots: Shift+Cmd+4 region, Shift+Cmd+3 screen, Shift+Cmd+5 toolbar; recording starts from
# the toolbar, so there is no separate record shortcut.
[io/github/OlehDzhumyk/Desk/capture]
capture-region-shortcut=['<Shift><Super>4']
capture-screen-shortcut=['<Shift><Super>3']
capture-toolbar-shortcut=['<Shift><Super>5']
capture-record-shortcut=@as []

# Window layouts: snap assist and hover picker off by default; Ctrl+Super+Up opens the picker.
[io/github/OlehDzhumyk/Desk/layouts]
snap-assist=false
hover-picker=false
layout-picker-shortcut=['<Control><Super>Up']

# Shortcut guide: hold Super (Cmd) to show active shortcuts in a centred cheat sheet.
[io/github/OlehDzhumyk/Desk/shortcut-guide]
enabled=true
