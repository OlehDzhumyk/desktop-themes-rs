# Clipboard history (clipboard-indicator@tudmotu.com) for the macOS theme: Super+Shift+V, no panel icon.
[org/gnome/shell/extensions/clipboard-indicator]
display-mode=3
open-at-cursor=true
history-size=50
cache-images=false
paste-on-select=true
move-item-first=true
notify-on-copy=false
notify-on-cycle=false
enable-keybindings=true
toggle-menu=['<Shift><Super>v']
private-mode-binding=['<Alt><Super>v']
clear-history=@as []
prev-entry=@as []
next-entry=@as []
