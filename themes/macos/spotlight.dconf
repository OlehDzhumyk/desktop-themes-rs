# Spotlight launcher (spotlight@nin) for the macOS theme. Part of the look module (extra *.dconf).
[org/gnome/shell/extensions/spotlight]
toggle-shortcut=['<Super>space']
theme-preference='default'

# Super+Space must not stay on the Overview. The macos behavior module clears it as well
# (behavior wins over look when both set a key); this line keeps the look correct when mixed
# with another theme's behavior.
[org/gnome/shell/keybindings]
toggle-overview=@as []
