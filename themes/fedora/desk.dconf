# desk-bridge skin for stock Fedora: clipboard history as a plain menu (Shift+Super+V and the
# «Буфер обміну» quick settings toggle).
[io/github/OlehDzhumyk/Desk]
skin='default'

[io/github/OlehDzhumyk/Desk/clipboard]
toggle-shortcut=['<Shift><Super>v']

# Emoji and symbol picker: Super+.
[io/github/OlehDzhumyk/Desk/emoji]
emoji-shortcut=['<Super>period']

# Colour picker: Shift+Super+C.
[io/github/OlehDzhumyk/Desk/color-picker]
color-picker-shortcut=['<Shift><Super>c']

# Text extractor (OCR): Shift+Super+T, as PowerToys Text Extractor.
[io/github/OlehDzhumyk/Desk/ocr]
ocr-shortcut=['<Shift><Super>t']

# Screenshots: none of our own; GNOME's Print (toolbar), Shift+Print (screen) and
# Ctrl+Shift+Alt+R (recording) stay in force.
[io/github/OlehDzhumyk/Desk/capture]
capture-region-shortcut=@as []
capture-screen-shortcut=@as []
capture-toolbar-shortcut=@as []
capture-record-shortcut=@as []
