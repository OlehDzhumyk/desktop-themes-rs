#: crates/themes-core/src/apply.rs:149
#, rust-format
msgid ""
"theme “{theme}” (module {module}) not found; its keys go back to the "
"standard values"
msgstr ""
"тему «{theme}» (модуль {module}) не знайдено — її ключі повертаються до "
"стандартних"

#: crates/themes-core/src/apply.rs:193
#, rust-format
msgid ""
"shortcut conflict: {conflict}; the feature keeps it, the system shortcut "
"loses it"
msgstr ""
"конфлікт скорочень: {conflict}; скорочення лишається функції, системне його "
"втрачає"

#: crates/themes-core/src/apply.rs:198
#, rust-format
msgid "shortcut conflict: {conflict}; change one of them (themes shortcut set)"
msgstr ""
"конфлікт скорочень: {conflict}; змініть одне з них (themes shortcut set)"

#: crates/themes-core/src/apply.rs:385
#, rust-format
msgid "extension {uuid} is not installed"
msgstr "розширення {uuid} не встановлене"

#: crates/themes-core/src/apply.rs:389
#, rust-format
msgid "extension {uuid} is turned off as broken (see “themes doctor”)"
msgstr "розширення {uuid} вимкнено як несправне (див. «themes doctor»)"

#: crates/themes-core/src/apply.rs:547
msgid ""
"GNOME turned extensions off after a shell crash (disable-user-"
"extensions=true): the theme's extensions will not work until you turn them "
"on (themes doctor --enable-extensions or the button in the Themes window)"
msgstr ""
"GNOME вимкнув розширення після збою оболонки (disable-user-extensions=true): "
"розширення теми не працюватимуть, доки ви їх не ввімкнете (themes doctor --"
"enable-extensions або кнопка у вікні «Теми»)"

#: crates/themes-core/src/apply.rs:555
msgid "the session is locked; new extensions turn on after unlocking"
msgstr "сеанс заблоковано — нові розширення ввімкнуться після розблокування"

#: crates/themes-core/src/apply.rs:576
#, rust-format
msgid ""
"the shell does not know the extension {uuid} yet (installed after login)"
msgstr "оболонка ще не знає про розширення {uuid} (встановлене після входу)"

#: crates/themes-core/src/apply.rs:582
#, rust-format
msgid "extension {uuid}: {state} {error}"
msgstr "розширення {uuid}: {state} {error}"

#: crates/themes-core/src/apply.rs:591
#, rust-format
msgid "extension {uuid} did not turn on live (state {state})"
msgstr "розширення {uuid} не ввімкнулося наживо (стан {state})"

#: crates/themes-core/src/apply.rs:602
#, rust-format
msgid "extension {uuid} did not turn off live"
msgstr "розширення {uuid} не вимкнулося наживо"

#: crates/themes-core/src/apply.rs:610
