msgstr "Скільки незакріплених записів зберігати"

#: crates/desk-settings/src/registry.rs:168
msgid "Images"
msgstr "Зображення"

#: crates/desk-settings/src/registry.rs:169
msgid "Also record copied images"
msgstr "Записувати також скопійовані зображення"

