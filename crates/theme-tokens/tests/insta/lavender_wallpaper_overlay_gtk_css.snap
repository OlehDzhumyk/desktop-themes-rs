  @define-color error_bg_color #c9405b;
  @define-color error_fg_color #ffffff;
  @define-color shade_color rgba(10, 6, 20, 0.251);
  .card, list.boxed-list, list.boxed-list-separate > row { box-shadow: 0 0 0 1px rgba(10, 6, 20, 0.051), 0px 1px 4px 0px rgba(10, 6, 20, 0.102); }
  popover > contents { box-shadow: 0 0 0 1px rgba(10, 6, 20, 0.11), 0px 4px 16px 0px rgba(10, 6, 20, 0.22); }
}

/* radii.button */
button:not(.circular):not(.pill):not(.sidebar-button):not(.color),
entry,
spinbutton,
splitbutton,
toggle-group { border-radius: 8px; }
windowcontrols > button { border-radius: 9999px; }
spinbutton > button { border-radius: 0; }
.linked:not(.vertical) > button:not(:first-child) { border-top-left-radius: 0; border-bottom-left-radius: 0; }
.linked:not(.vertical) > button:not(:last-child) { border-top-right-radius: 0; border-bottom-right-radius: 0; }
.linked.vertical > button:not(:first-child) { border-top-left-radius: 0; border-top-right-radius: 0; }
.linked.vertical > button:not(:last-child) { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.linked:not(.vertical) > menubutton:not(:first-child) > button { border-top-left-radius: 0; border-bottom-left-radius: 0; }
.linked:not(.vertical) > menubutton:not(:last-child) > button { border-top-right-radius: 0; border-bottom-right-radius: 0; }
.linked.vertical > menubutton:not(:first-child) > button { border-top-left-radius: 0; border-top-right-radius: 0; }
.linked.vertical > menubutton:not(:last-child) > button { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.linked:not(.vertical) > dropdown:not(:first-child) > button { border-top-left-radius: 0; border-bottom-left-radius: 0; }
.linked:not(.vertical) > dropdown:not(:last-child) > button { border-top-right-radius: 0; border-bottom-right-radius: 0; }
.linked.vertical > dropdown:not(:first-child) > button { border-top-left-radius: 0; border-top-right-radius: 0; }
.linked.vertical > dropdown:not(:last-child) > button { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.linked:not(.vertical) > combobox:not(:first-child) > box > button { border-top-left-radius: 0; border-bottom-left-radius: 0; }
.linked:not(.vertical) > combobox:not(:last-child) > box > button { border-top-right-radius: 0; border-bottom-right-radius: 0; }
.linked.vertical > combobox:not(:first-child) > box > button { border-top-left-radius: 0; border-top-right-radius: 0; }
.linked.vertical > combobox:not(:last-child) > box > button { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.linked:not(.vertical) > entry:not(:first-child) { border-top-left-radius: 0; border-bottom-left-radius: 0; }
.linked:not(.vertical) > entry:not(:last-child) { border-top-right-radius: 0; border-bottom-right-radius: 0; }
.linked.vertical > entry:not(:first-child) { border-top-left-radius: 0; border-top-right-radius: 0; }
.linked.vertical > entry:not(:last-child) { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
splitbutton > button { border-top-right-radius: 0; border-bottom-right-radius: 0; }
splitbutton > menubutton > button { border-top-left-radius: 0; border-bottom-left-radius: 0; }
popover.menu modelbutton, popover.menu list > row, popover.menu listview > row,
.navigation-sidebar > row, .navigation-sidebar > child, tooltip, tabbar tab { border-radius: 8px; }

/* radii.card */
list.boxed-list, list.content, list.boxed-list-separate > row, .card, frame,
menubutton.card > button { border-radius: 12px; }
list.boxed-list > row:first-child, list.content > row:first-child { border-top-left-radius: 12px; border-top-right-radius: 12px; }
list.boxed-list > row:last-child, list.content > row:last-child { border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; }

/* radii.popover */
popover > contents, popover.menu > contents { border-radius: 12px; }

/* fonts.title_weight */
windowtitle > .title, headerbar .title { font-weight: 700; }

/* motion */
button, modelbutton, row, tab { transition-duration: 150ms; transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1); }
switch, switch > slider, checkbutton > check, checkbutton > radio, entry, stackswitcher > button { transition-duration: 220ms; transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1); }
