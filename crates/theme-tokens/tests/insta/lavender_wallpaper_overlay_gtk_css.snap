  @define-color headerbar_backdrop_color #141a17;
  @define-color sidebar_bg_color #19201d;
  @define-color sidebar_fg_color #eaf0ed;
  @define-color sidebar_backdrop_color #141a17;
  @define-color card_bg_color #212825;
  @define-color card_fg_color #eaf0ed;
  @define-color popover_bg_color #262d2a;
  @define-color popover_fg_color #eaf0ed;
  @define-color dialog_bg_color #1d2320;
  @define-color dialog_fg_color #eaf0ed;
  @define-color destructive_bg_color #ca5551;
