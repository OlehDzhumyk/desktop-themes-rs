/* Generated by desktop-themes-rs from themes/lavender/tokens.toml. Do not edit: change the tokens and apply the theme again. */
/* libadwaita 1.10: CSS variables, light/dark via prefers-color-scheme */

:root {
  --window-radius: 14px;
}

@media (prefers-color-scheme: light) {
  :root {
    --accent-bg-color: #2f8366;
    --accent-fg-color: #ffffff;
    --window-bg-color: #f0f9f5;
    --window-fg-color: #131d19;
    --view-bg-color: #fbfefd;
    --view-fg-color: #131d19;
    --headerbar-bg-color: #e9f3ee;
    --headerbar-fg-color: #131d19;
    --headerbar-backdrop-color: #f0f9f5;
    --sidebar-bg-color: #e3eee9;
    --sidebar-fg-color: #131d19;
    --sidebar-backdrop-color: #f0f9f5;
    --card-bg-color: #fbfefd;
    --card-fg-color: #131d19;
    --popover-bg-color: #fbfefd;
    --popover-fg-color: #131d19;
    --dialog-bg-color: #f0f9f5;
    --dialog-fg-color: #131d19;
    --destructive-bg-color: #c13c3b;
    --destructive-fg-color: #ffffff;
    --success-bg-color: #00893d;
    --success-fg-color: #ffffff;
    --warning-bg-color: #eab532;
    --warning-fg-color: rgba(0, 0, 0, 0.8);
    --error-bg-color: #c22e4c;
    --error-fg-color: #ffffff;
    --shade-color: rgba(26, 16, 48, 0.078);
    --border-opacity: 14%;
  }
  @define-color accent_bg_color #2f8366;
  @define-color accent_fg_color #ffffff;
  @define-color window_bg_color #f0f9f5;
  @define-color window_fg_color #131d19;
  @define-color view_bg_color #fbfefd;
  @define-color view_fg_color #131d19;
  @define-color headerbar_bg_color #e9f3ee;
  @define-color headerbar_fg_color #131d19;
  @define-color headerbar_backdrop_color #f0f9f5;
  @define-color sidebar_bg_color #e3eee9;
  @define-color sidebar_fg_color #131d19;
  @define-color sidebar_backdrop_color #f0f9f5;
  @define-color card_bg_color #fbfefd;
  @define-color card_fg_color #131d19;
  @define-color popover_bg_color #fbfefd;
  @define-color popover_fg_color #131d19;
  @define-color dialog_bg_color #f0f9f5;
  @define-color dialog_fg_color #131d19;
  @define-color destructive_bg_color #c13c3b;
  @define-color destructive_fg_color #ffffff;
  @define-color success_bg_color #00893d;
  @define-color success_fg_color #ffffff;
  @define-color warning_bg_color #eab532;
  @define-color warning_fg_color rgba(0, 0, 0, 0.8);
  @define-color error_bg_color #c22e4c;
  @define-color error_fg_color #ffffff;
  @define-color shade_color rgba(26, 16, 48, 0.078);
  .card, list.boxed-list, list.boxed-list-separate > row { box-shadow: 0 0 0 1px rgba(26, 16, 48, 0.051), 0px 1px 4px 0px rgba(26, 16, 48, 0.102); }
  popover > contents { box-shadow: 0 0 0 1px rgba(26, 16, 48, 0.11), 0px 4px 16px 0px rgba(26, 16, 48, 0.22); }
}

