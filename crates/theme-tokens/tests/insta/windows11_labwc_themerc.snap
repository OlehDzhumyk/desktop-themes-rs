---
source: crates/theme-tokens/tests/insta_snapshots.rs
expression: "extra(id, name, ExtraTarget::LabwcTheme)"
---
# Generated by desktop-themes-rs from themes/windows11/tokens.toml. Do not edit: change the tokens and apply the theme again.
# labwc theme (labwc-theme(5)), dark scheme. The corner radius is set in rc.xml.

# --- geometry ---
border.width: 1
padding.width: 8
window.titlebar.padding.width: 0
window.titlebar.padding.height: 0
window.button.spacing: 0

# --- active window ---
window.active.border.color: #4d4d51
window.active.title.bg.color: #2e2e32
window.active.label.text.color: #ffffff
window.active.button.unpressed.image.color: #ffffff
window.active.button.hover.image.color: #ffffff

# --- inactive window ---
window.inactive.border.color: #39393d
window.inactive.title.bg.color: #222226
window.inactive.label.text.color: #a7a7a8
window.inactive.button.unpressed.image.color: #a7a7a8

# --- close button: red on hover ---
window.active.button.close.unpressed.image.color: #ffffff
window.inactive.button.close.unpressed.image.color: #a7a7a8
window.active.button.close.hover.image.color: #ffffff
window.active.button.close.hover.bg.color: #c01c28

# --- menus (window menu, root menu) ---
menu.border.width: 1
menu.border.color: #545457
menu.items.bg.color: #36363a
menu.items.text.color: #ffffff
menu.items.active.bg.color: #4a4a4e
menu.items.active.text.color: #ffffff
menu.items.padding.x: 12
menu.items.padding.y: 6
menu.separator.color: #545457
menu.title.bg.color: #36363a
menu.title.text.color: #ffffff

# --- on-screen display (window switcher) ---
osd.bg.color: #36363a
osd.border.color: #545457
osd.border.width: 1
osd.label.text.color: #ffffff
osd.window-switcher.item.active.bg.color: #4a4a4e
osd.window-switcher.item.active.border.color: #3584e4
osd.window-switcher.item.active.border.width: 2

# --- snap overlay ---
snapping.overlay.region.bg.color: #3584e433
snapping.overlay.edge.bg.color: #3584e433
snapping.overlay.region.border.color: #3584e4
snapping.overlay.edge.border.color: #3584e4
