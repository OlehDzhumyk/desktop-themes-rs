---
source: crates/theme-tokens/tests/insta_snapshots.rs
expression: "extra(id, name, ExtraTarget::LabwcTheme)"
---
# Generated by desktop-themes-rs from themes/lavender/tokens.toml. Do not edit: change the tokens and apply the theme again.
# labwc theme (labwc-theme(5)), dark scheme. The corner radius is set in rc.xml.

# --- geometry ---
border.width: 1
padding.width: 6
window.titlebar.padding.width: 3
window.titlebar.padding.height: 3
window.button.spacing: 3
window.button.hover.bg.shape: rectangle
window.button.hover.bg.corner-radius: 8

# --- active window ---
window.active.border.color: #423e4e
window.active.title.bg.color: #262232
window.active.label.text.color: #ebe7f5
window.active.button.unpressed.image.color: #ebe7f5
window.active.button.hover.image.color: #ebe7f5

# --- inactive window ---
window.inactive.border.color: #312e3b
window.inactive.title.bg.color: #1d1a27
window.inactive.label.text.color: #9995a3
window.inactive.button.unpressed.image.color: #9995a3

# --- close button: red on hover ---
window.active.button.close.unpressed.image.color: #ebe7f5
window.inactive.button.close.unpressed.image.color: #9995a3
window.active.button.close.hover.image.color: #ffffff
window.active.button.close.hover.bg.color: #c9405b

# --- shadows (shadows.popover) ---
window.active.shadow.size: 16
window.inactive.shadow.size: 8
window.active.shadow.color: #0a061438
window.inactive.shadow.color: #0a061422

# --- menus (window menu, root menu) ---
menu.border.width: 1
menu.border.color: #474354
menu.items.bg.color: #2c283a
menu.items.text.color: #ebe7f5
menu.items.active.bg.color: #3f3b4d
menu.items.active.text.color: #ebe7f5
menu.items.padding.x: 12
menu.items.padding.y: 6
menu.separator.color: #474354
menu.title.bg.color: #2c283a
menu.title.text.color: #ebe7f5

# --- on-screen display (window switcher) ---
osd.bg.color: #2c283a
osd.border.color: #474354
osd.border.width: 1
osd.label.text.color: #ebe7f5
osd.window-switcher.item.active.bg.color: #3f3b4d
osd.window-switcher.item.active.border.color: #8f74e6
osd.window-switcher.item.active.border.width: 2

# --- snap overlay ---
snapping.overlay.region.bg.color: #8f74e633
snapping.overlay.edge.bg.color: #8f74e633
snapping.overlay.region.border.color: #8f74e6
snapping.overlay.edge.border.color: #8f74e6
