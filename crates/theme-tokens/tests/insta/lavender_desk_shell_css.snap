/* Generated by desktop-themes-rs from themes/lavender/tokens.toml. Do not edit: change the tokens and apply the theme again. */
/* desk-shell: --ds-* palette (GTK 4.16+ custom properties) and surfaces */

/* light palette */
@define-color desk_shell_light_bg rgba(247, 245, 252, 0.878);
@define-color desk_shell_light_flyout rgba(255, 255, 255, 0.969);
@define-color desk_shell_light_fg #221c35;
@define-color desk_shell_light_dim rgba(34, 28, 53, 0.62);
@define-color desk_shell_light_hover rgba(34, 28, 53, 0.055);
@define-color desk_shell_light_active rgba(34, 28, 53, 0.09);
@define-color desk_shell_light_stroke rgba(34, 28, 53, 0.141);
@define-color desk_shell_light_field rgba(253, 252, 255, 0.851);
@define-color desk_shell_light_accent #6d4fc2;
@define-color desk_shell_light_on_accent #ffffff;
.desk-shell.light:not(.hc) {
  --ds-bg: rgba(247, 245, 252, 0.878);
  --ds-flyout: rgba(255, 255, 255, 0.969);
  --ds-fg: #221c35;
  --ds-dim: rgba(34, 28, 53, 0.62);
  --ds-hover: rgba(34, 28, 53, 0.055);
  --ds-active: rgba(34, 28, 53, 0.09);
  --ds-stroke: rgba(34, 28, 53, 0.141);
  --ds-field: rgba(253, 252, 255, 0.851);
  --ds-accent: #6d4fc2;
  --ds-on-accent: #ffffff;
}

/* dark palette */
@define-color desk_shell_dark_bg rgba(29, 26, 39, 0.878);
@define-color desk_shell_dark_flyout rgba(44, 40, 58, 0.969);
@define-color desk_shell_dark_fg #ebe7f5;
@define-color desk_shell_dark_dim rgba(235, 231, 245, 0.722);
@define-color desk_shell_dark_hover rgba(235, 231, 245, 0.059);
@define-color desk_shell_dark_active rgba(235, 231, 245, 0.102);
@define-color desk_shell_dark_stroke rgba(235, 231, 245, 0.141);
@define-color desk_shell_dark_field rgba(235, 231, 245, 0.059);
@define-color desk_shell_dark_accent #8f74e6;
@define-color desk_shell_dark_on_accent #ffffff;
.desk-shell.dark:not(.hc) {
  --ds-bg: rgba(29, 26, 39, 0.878);
  --ds-flyout: rgba(44, 40, 58, 0.969);
  --ds-fg: #ebe7f5;
  --ds-dim: rgba(235, 231, 245, 0.722);
  --ds-hover: rgba(235, 231, 245, 0.059);
  --ds-active: rgba(235, 231, 245, 0.102);
  --ds-stroke: rgba(235, 231, 245, 0.141);
  --ds-field: rgba(235, 231, 245, 0.059);
  --ds-accent: #8f74e6;
  --ds-on-accent: #ffffff;
}

/* radii.button, radii.popover */
.desk-shell { --ds-radius: 8px; --ds-flyout-radius: 12px; }

/* surfaces */
.desk-shell-taskbar {
  background-color: var(--ds-bg);
  border-top: 1px solid var(--ds-stroke);
}
.desk-shell-start-menu,
.desk-shell-flyout {
  background-color: var(--ds-flyout);
  border: 1px solid var(--ds-stroke);
  border-radius: var(--ds-flyout-radius);
  color: var(--ds-fg);
}
.desk-shell-taskbar button,
.desk-shell-start-menu .tile,
.desk-shell-start-menu list row,
.desk-shell-flyout button,
.desk-shell-flyout list row { border-radius: var(--ds-radius); }

/* hover and active states */
.desk-shell-taskbar button:hover,
.desk-shell-start-menu .tile:hover,
.desk-shell-start-menu list row:hover,
.desk-shell-flyout button:hover,
.desk-shell-flyout list row:hover { background-color: var(--ds-hover); }
.desk-shell-taskbar button:active,
.desk-shell-taskbar button:checked,
.desk-shell-start-menu .tile:active,
.desk-shell-flyout button:active { background-color: var(--ds-active); }
.desk-shell-taskbar .pin:checked { border-bottom-color: var(--ds-accent); }
.desk-shell-flyout .qs-tile:checked {
  background-color: var(--ds-accent);
  color: var(--ds-on-accent);
  border-color: var(--ds-accent);
}

/* shadows.popover */
.desk-shell-start-menu,
.desk-shell-flyout { box-shadow: 0px 4px 16px 0px rgba(0, 0, 0, 0.22); }
