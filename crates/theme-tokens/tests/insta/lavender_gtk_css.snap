    --headerbar-backdrop-color: #f7f5fc;
    --sidebar-bg-color: #ebe6f6;
    --sidebar-fg-color: #221c35;
    --sidebar-backdrop-color: #f1eef9;
    --card-bg-color: #ffffff;
    --card-fg-color: #221c35;
    --popover-bg-color: #ffffff;
    --popover-fg-color: #221c35;
    --dialog-bg-color: #f7f5fc;
    --dialog-fg-color: #221c35;
    --destructive-bg-color: #c22e4c;
    --destructive-fg-color: #ffffff;
    --success-bg-color: #2c7a55;
    --success-fg-color: #ffffff;
    --warning-bg-color: #e0a526;
    --warning-fg-color: rgba(0, 0, 0, 0.8);
    --error-bg-color: #c22e4c;
    --error-fg-color: #ffffff;
    --shade-color: rgba(26, 16, 48, 0.078);
    --border-opacity: 14%;
  }
  @define-color accent_bg_color #6d4fc2;
  @define-color accent_fg_color #ffffff;
  @define-color window_bg_color #f7f5fc;
  @define-color window_fg_color #221c35;
  @define-color view_bg_color #fdfcff;
