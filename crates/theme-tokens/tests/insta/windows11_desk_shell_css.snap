source: crates/theme-tokens/tests/insta_snapshots.rs
expression: "extra(id, name, ExtraTarget::DeskShellCss)"
---
/* Generated by desktop-themes-rs from themes/windows11/tokens.toml. Do not edit: change the tokens and apply the theme again. */
/* desk-shell: --ds-* palette (GTK 4.16+ custom properties) and surfaces */

/* light palette */
@define-color desk_shell_light_bg rgba(243, 243, 243, 0.922);
@define-color desk_shell_light_flyout rgba(249, 249, 249, 0.961);
@define-color desk_shell_light_fg #1b1b1b;
@define-color desk_shell_light_dim rgba(27, 27, 27, 0.62);
@define-color desk_shell_light_hover rgba(27, 27, 27, 0.055);
@define-color desk_shell_light_active rgba(27, 27, 27, 0.09);
@define-color desk_shell_light_stroke rgba(27, 27, 27, 0.078);
@define-color desk_shell_light_field rgba(255, 255, 255, 0.851);
.desk-shell.light:not(.hc) {
  --ds-bg: rgba(243, 243, 243, 0.922);
  --ds-flyout: rgba(249, 249, 249, 0.961);
  --ds-fg: #1b1b1b;
  --ds-dim: rgba(27, 27, 27, 0.62);
  --ds-hover: rgba(27, 27, 27, 0.055);
  --ds-active: rgba(27, 27, 27, 0.09);
  --ds-stroke: rgba(27, 27, 27, 0.078);
  --ds-field: rgba(255, 255, 255, 0.851);
}

/* dark palette */
@define-color desk_shell_dark_bg rgba(32, 32, 32, 0.902);
@define-color desk_shell_dark_flyout rgba(44, 44, 44, 0.961);
@define-color desk_shell_dark_fg #ffffff;
@define-color desk_shell_dark_dim rgba(255, 255, 255, 0.722);
@define-color desk_shell_dark_hover rgba(255, 255, 255, 0.059);
@define-color desk_shell_dark_active rgba(255, 255, 255, 0.102);
@define-color desk_shell_dark_stroke rgba(255, 255, 255, 0.09);
@define-color desk_shell_dark_field rgba(255, 255, 255, 0.059);
.desk-shell.dark:not(.hc) {
  --ds-bg: rgba(32, 32, 32, 0.902);
  --ds-flyout: rgba(44, 44, 44, 0.961);
  --ds-fg: #ffffff;
  --ds-dim: rgba(255, 255, 255, 0.722);
  --ds-hover: rgba(255, 255, 255, 0.059);
  --ds-active: rgba(255, 255, 255, 0.102);
  --ds-stroke: rgba(255, 255, 255, 0.09);
  --ds-field: rgba(255, 255, 255, 0.059);
}

/* surfaces */
.desk-shell-taskbar {
  background-color: var(--ds-bg);
  border-top: 1px solid var(--ds-stroke);
}
.desk-shell-start-menu,
.desk-shell-flyout {
  background-color: var(--ds-flyout);
  border: 1px solid var(--ds-stroke);
  border-radius: var(--ds-flyout-radius);
  color: var(--ds-fg);
}
.desk-shell-taskbar button,
.desk-shell-start-menu .tile,
.desk-shell-start-menu list row,
.desk-shell-flyout button,
.desk-shell-flyout list row { border-radius: var(--ds-radius); }

/* hover and active states */
.desk-shell-taskbar button:hover,
.desk-shell-start-menu .tile:hover,
.desk-shell-start-menu list row:hover,
.desk-shell-flyout button:hover,
.desk-shell-flyout list row:hover { background-color: var(--ds-hover); }
.desk-shell-taskbar button:active,
.desk-shell-taskbar button:checked,
.desk-shell-start-menu .tile:active,
.desk-shell-flyout button:active { background-color: var(--ds-active); }
.desk-shell-taskbar .pin:checked { border-bottom-color: var(--ds-accent); }
.desk-shell-flyout .qs-tile:checked {
  background-color: var(--ds-accent);
  color: var(--ds-on-accent);
  border-color: var(--ds-accent);
}
