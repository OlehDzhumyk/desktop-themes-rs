#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Session launcher of "Desk (Windows 11 / labwc)": labwc + desk-shell + deskd.
# The display manager runs it from data/labwc/desk-win11.desktop (docs/wayland-session.md).
#
#   1. Find the bundled config (data/labwc/windows11) and copy it into the session config
#      directory, ${XDG_CONFIG_HOME:-~/.config}/desk-labwc, on each start. rc.local.xml and
#      autostart.user in that directory belong to you and are never overwritten; when
#      rc.local.xml exists, labwc uses it instead of the bundled rc.xml.
#   2. Install the labwc theme desk-win11 (~/.local/share/themes/desk-win11/openbox-3/themerc).
#   3. Export the session environment and replace this process with labwc.
#
# Usage: desk-win11-session [--dry-run]   (--dry-run: set up the files, print the labwc command)
# Environment: DESK_LABWC_SRC  the bundled config directory, when it is not in a default place.
set -euo pipefail

DRY=0
case "${1:-}" in
  --dry-run|-n) DRY=1 ;;
  -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
  "") ;;
  *) echo "unknown option: $1" >&2; exit 2 ;;
esac

DATA=${XDG_DATA_HOME:-$HOME/.local/share}
CFG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/desk-labwc
THEME_DIR=$DATA/themes/desk-win11/openbox-3

# Programs of this project are installed per user (data/install.sh); a display manager does not
# always put ~/.local/bin on PATH.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH

# 1. bundled config: explicit, next to this script (repository checkout), user data, system data
SRC=
self_dir=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
for d in "${DESK_LABWC_SRC:-}" "$self_dir/windows11" "$DATA/desktop-themes/labwc/windows11" \
         /usr/local/share/desktop-themes/labwc/windows11 /usr/share/desktop-themes/labwc/windows11; do
  if [ -n "$d" ] && [ -r "$d/rc.xml" ]; then SRC=$d; break; fi
done
if [ -z "$SRC" ]; then
  echo "desk-win11-session: bundled labwc config not found (set DESK_LABWC_SRC)" >&2
  exit 1
fi
command -v labwc >/dev/null 2>&1 || { echo "desk-win11-session: labwc is not installed" >&2; exit 1; }

mkdir -p "$CFG_DIR" "$THEME_DIR"
for f in autostart capture; do
  install -m 0755 "$SRC/$f" "$CFG_DIR/$f"
done
if [ -r "$CFG_DIR/rc.local.xml" ]; then
  install -m 0644 "$CFG_DIR/rc.local.xml" "$CFG_DIR/rc.xml"
else
  install -m 0644 "$SRC/rc.xml" "$CFG_DIR/rc.xml"
fi

# 2. window decoration theme, referenced by <theme><name> in rc.xml
install -m 0644 "$SRC/themerc" "$THEME_DIR/themerc"

# 3. session environment
export XDG_CURRENT_DESKTOP=labwc:wlroots
export XDG_SESSION_DESKTOP=desk-win11
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export DESK_LABWC_DIR="$CFG_DIR"

# labwc runs "$CFG_DIR/autostart" by itself because it is in the config directory. Do not pass it
# with -S: labwc would run it twice and exit as soon as the script returns.
if [ "$DRY" = 1 ]; then
  printf 'labwc -C %q\n' "$CFG_DIR"
  exit 0
fi
exec labwc -C "$CFG_DIR"
