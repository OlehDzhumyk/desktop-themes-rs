<!-- Settings of deskd and the shell bridge desk-bridge@desktop-themes-rs. One place for all front
     ends: deskd, the bridge, the «Робочий стіл» window and `gsettings`. Installed into
     ~/.local/share/glib-2.0/schemas by data/install.sh. -->
<schemalist gettext-domain="desktop-themes-rs">
  <schema id="io.github.OlehDzhumyk.Desk" path="/io/github/OlehDzhumyk/Desk/">
    <key name="skin" type="s">
      <choices>
        <choice value="default"/>
        <choice value="macos"/>
        <choice value="windows11"/>
      </choices>
      <default>'default'</default>
      <summary>Skin of the shell-side UI</summary>
      <description>Which UI variant and stylesheet the bridge uses for its panels. Themes set it in their look module (desk.dconf).</description>
    </key>
    <child name="clipboard" schema="io.github.OlehDzhumyk.Desk.Clipboard"/>
  </schema>

  <schema id="io.github.OlehDzhumyk.Desk.Clipboard" path="/io/github/OlehDzhumyk/Desk/clipboard/">
    <key name="enabled" type="b">
      <default>true</default>
      <summary>Record clipboard history</summary>
    </key>
    <key name="history-size" type="u">
      <range min="5" max="500"/>
      <default>50</default>
      <summary>Maximum number of unpinned items</summary>
    </key>
    <key name="images" type="b">
      <default>true</default>
      <summary>Record images</summary>
    </key>
    <key name="image-max-kb" type="u">
      <range min="64" max="65536"/>
      <default>8192</default>
      <summary>Largest image recorded, in KiB</summary>
    </key>
    <key name="persist" type="b">
      <default>true</default>
      <summary>Keep text history across sessions</summary>
      <description>Stored in ~/.local/share/deskd/clipboard (mode 0600).</description>
    </key>
    <key name="persist-images" type="b">
      <default>false</default>
      <summary>Keep images across sessions</summary>
      <description>Off by default: images live only in $XDG_RUNTIME_DIR while the session runs.</description>
    </key>
    <key name="private-mode" type="b">
      <default>false</default>
      <summary>Private mode: record nothing</summary>
    </key>
    <key name="paste-on-select" type="b">
      <default>true</default>
      <summary>Paste the selected item into the focused window</summary>
    </key>
    <key name="toggle-shortcut" type="as">
      <default><![CDATA[['<Shift><Super>v']]]></default>
      <summary>Shortcut that opens the clipboard panel</summary>
      <description>Themes set it in desk.dconf: Super+V for Windows 11, Shift+Super+V for macOS.</description>
    </key>
    <key name="excluded-apps" type="as">
      <default>['org.keepassxc.KeePassXC', 'KeePassXC', 'keepassxc', 'Bitwarden', 'bitwarden', 'com.bitwarden.desktop', '1Password', '1password', 'org.gnome.World.Secrets', 'secrets', 'org.gnome.seahorse.Application', 'Seahorse', 'proton-pass', 'Proton Pass', 'me.proton.Pass']</default>
      <summary>Applications whose copies are never recorded (WM class or app id)</summary>
    </key>
  </schema>
</schemalist>
