<component type="desktop-application">
  <id>io.github.OlehDzhumyk.Themes</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Desktop</name>
  <summary>Switch and mix the look of the GNOME desktop</summary>
  <description>
    <p>Switches the whole look of GNOME between Fedora, macOS, macOS Liquid Glass and Windows 11, and lets you mix modules: the macOS look with Windows 11 keyboard behaviour, for example.</p>
    <p>Desktop features that Windows 11 and macOS both have, such as a clipboard history, come with it. Everything works at user level, without administrator rights.</p>
  </description>
  <launchable type="desktop-id">io.github.OlehDzhumyk.Themes.desktop</launchable>
  <url type="homepage">https://github.com/OlehDzhumyk/desktop-themes-rs</url>
  <url type="bugtracker">https://github.com/OlehDzhumyk/desktop-themes-rs/issues</url>
  <url type="vcs-browser">https://github.com/OlehDzhumyk/desktop-themes-rs</url>
  <developer id="io.github.olehdzhumyk">
    <name translate="no">OlehDzhumyk</name>
  </developer>
  <categories>
    <category>GNOME</category>
    <category>GTK</category>
    <category>Settings</category>
    <category>DesktopSettings</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>
  <releases>
    <release version="0.3.0" date="2026-11-22">
      <url type="details">https://github.com/OlehDzhumyk/desktop-themes-rs/releases/tag/v0.3.0</url>
    </release>
    <release version="0.2.0" date="2026-11-21">
      <url type="details">https://github.com/OlehDzhumyk/desktop-themes-rs/releases/tag/v0.2.0</url>
    </release>
    <release version="0.1.0" date="2026-11-21">
      <url type="details">https://github.com/OlehDzhumyk/desktop-themes-rs/releases/tag/v0.1.0</url>
    </release>
  </releases>
  <translation type="gettext">desktop-themes-rs</translation>
</component>
